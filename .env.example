# ── MAROS Meals ──────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── LLM (planning only) ──────────────────────────────────────────────────
# Only the PLAN stage calls an LLM. Transcription, verification, narration
# and rendering are all local and free, so a run that gets past planning
# finishes without any API quota.
GROQ_API_KEY=gsk_...

# Groq namespaces its model ids. The bare name `gpt-oss-120b` returns a 404
# that reads like the model was deprecated — it needs the `openai/` prefix.
GROQ_MODEL=openai/gpt-oss-120b

# Optional extra keys, comma separated. Each Groq ACCOUNT has its own daily
# token allowance (200k on the free tier), and a full-length course costs most
# of one. Listing keys from different accounts multiplies the daily ceiling;
# the planner rotates to the next key when the current account's daily limit
# is reached.
# GROQ_API_KEYS=gsk_second,gsk_third

# Optional. Tried before Groq when set.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Tokens per minute the account allows. Groq's free tier is 8000, which is
# less than a 45-minute lecture, so Pass 1 is windowed and every call is
# rate-budgeted against this number. Raise it if the key is upgraded.
MAROS_LLM_TPM=8000

# ── MAROS backend ────────────────────────────────────────────────────────
# The Python backend is a SEPARATE project and the source of truth. This one
# reads from it (transcripts, TTS, Whisper) and never writes to it.
MAROS_ROOT=/Users/biradatiya/Desktop/MAROS
MAROS_API=http://127.0.0.1:8000

# ── Voice ────────────────────────────────────────────────────────────────
# edge-tts, free and local. Original synthetic voice — never a clone.
MEAL_VOICE=en-US-BrianNeural
